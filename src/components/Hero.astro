<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <span class="orb orb--blue" data-parallax="0.25"></span>
    <span class="orb orb--orange" data-parallax="0.4"></span>
    <span class="orb orb--violet" data-parallax="0.15"></span>
    <span class="hero__grid"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="pill hero-in" style="--d: 0ms">
        <span class="pill__dot"></span>
        Open to engineering conversations
      </p>
      <h1 class="hero-in" style="--d: 100ms">
        Hi, I'm <span class="grad">Divyaraj</span>.<br />
        I lead teams that build <span class="grad">secure systems</span>.
      </h1>
      <p class="hero__subtitle hero-in" style="--d: 220ms">
        Engineering Manager at JumpCloud with 10+ years across Security SaaS and
        FinTech. Java, Golang, Python and AWS, with a focus on identity,
        reliability and high-performing teams.
      </p>
      <div class="hero__actions hero-in" style="--d: 340ms">
        <a class="btn btn--primary" href="#experience">See my impact</a>
        <a class="btn btn--ghost" href="#contact">Get in touch</a>
      </div>
      <ul class="hero__stats hero-in" style="--d: 460ms">
        <li><strong>10+</strong><span>Years</span></li>
        <li><strong>15+</strong><span>Engineers led</span></li>
        <li><strong>99.9%</strong><span>Uptime</span></li>
      </ul>
    </div>

    <div class="hero__visual hero-in" style="--d: 250ms">
      <div class="portrait-wrap">
        <div class="portrait">
          <img
            src="/images/profile.jpg"
            alt="Divyaraj Singh Sisodia"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="float-card float-card--a">
          <span class="float-card__label">Currently</span>
          <strong>Engineering Manager</strong>
          <span>JumpCloud · Bangalore</span>
        </div>
        <div class="float-card float-card--b">
          <span class="float-card__label">Stack</span>
          <strong>Java · Go · Python · AWS</strong>
        </div>
      </div>
    </div>
  </div>

  <a href="#about" class="scroll-cue" aria-label="Scroll to About">
    <span></span>
  </a>
</section>
